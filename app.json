{
  "expo": {
    "name": "Miço",
    "slug": "mico-mobile",
    "version": "0.1.0",
    "scheme": "mico",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mavirotamarine.mico",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.mavirotamarine.mico",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "MİÇO, tekne fotoğrafı eklemen için fotoğraflarına erişim istiyor."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermissionDescription": "MİÇO, servis talebine konumunu eklemen için konumuna erişim istiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/logo-icon.png",
          "color": "#060F20"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dadf7080-fa25-4ed3-af3a-4d60c7e3bffa"
      }
    },
    "owner": "mavirotamarines-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dadf7080-fa25-4ed3-af3a-4d60c7e3bffa"
    }
  }
}
